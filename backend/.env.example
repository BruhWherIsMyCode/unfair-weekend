# Python backend: use uv run --env-file .env, or export these variables.
# Choose your own demo key; the application has no default credential.
DEMO_KEY=
RING_TIMEOUT_S=30
CALL_TIMEOUT_S=180
CALL_RUNNER=auto
DEMO_PERSON_ID=p_demo
DEMO_PERSON_NAME=Ona
DEMO_PERSON_PRONOUN=she
DEMO_FAMILY_ID=f_demo
DEMO_SESSION_LABEL=live

# Agent 3's analysis (CALL_RUNNER=analysis or auto). All optional, see README "Running with Agent 3's analysis".
CALL_DRIVER=
UW_CLAUDE_BACKEND=
UW_MIRRORED=
UW_BASELINE_PERSON=
UW_DATA_DIR=
UW_BASELINE_NEEDED=
UW_SAFETY_FLOOR=
UW_CALL_LOG=
# Shared SQLite file (backend/DATABASE_SCHEMA.md). Unset = off. When set, the migrations are applied at startup and
# Agent 3's recorder reads her usual from it and records each call (analysis/storage/README.md).
# DATABASE_PATH=

# Voice, answer transcription, and explicit video preparation (also used by the Node reference).
SIMLI_API_KEY=
ELEVENLABS_API_KEY=

# Optional: choose an avatar and a voice from your provider dashboards.
SIMLI_FACE_ID=bf13113a-355a-4d97-8b90-4edccd1da7b2
# live: the phone streams each line to a Simli live avatar (clips and voice are the fallback).
# clips: prepared clips only, without rebuilding the app.
AVATAR_MODE=live
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STT_MODEL_ID=scribe_v2
# Node reference port; Uvicorn uses its --port argument.
PORT=3000
