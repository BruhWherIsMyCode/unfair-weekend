# Python backend: use uv run --env-file .env, or export these variables.
# Choose your own demo key; the application has no default credential.
DEMO_KEY=
RING_TIMEOUT_S=30
CALL_TIMEOUT_S=180
CALL_RUNNER=auto
# JSON lines for the Python backend, with automatic size rotation (3 backups per file).
# Default paths are backend/.cache/logs regardless of the shell's working directory.
LOG_LEVEL=INFO
LOG_CONSOLE=on
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=3
# Override paths if needed. Set a value to empty to disable that file (e.g. LOG_ERROR_FILE= for one file).
# LOG_FILE=.cache/logs/backend.log
# LOG_ERROR_FILE=.cache/logs/errors.log
DEMO_PERSON_ID=p_demo
# The person who is called (name, he/she, age, a few facts) lives in checkin_backend/data/person.json.
DEMO_FAMILY_ID=f_demo
DEMO_SESSION_LABEL=live

# Agent 3's analysis (CALL_RUNNER=analysis or auto). All optional, see README "Running with Agent 3's analysis".
CALL_DRIVER=
UW_CLAUDE_BACKEND=
# off requires Claude and stops the call on a model failure instead of switching to the fixed script.
# This setting does not control avatar clips or voice playback.
UW_CLAUDE_FALLBACK=on
UW_MIRRORED=
UW_BASELINE_PERSON=
UW_DATA_DIR=
# Successful calls before the backend finishes learning (default 2).
UW_BASELINE_NEEDED=2
UW_SAFETY_FLOOR=
UW_CALL_LOG=
# Shared SQLite file (backend/DATABASE_SCHEMA.md). Unset = off. When set, the migrations are applied at startup and
# Agent 3's recorder reads her usual from it and records each call (analysis/storage/README.md).
# DATABASE_PATH=

# Optional retained MP4s for each camera task attempt (smile/arms, including learning and retries).
# Empty disables recording. Use a folder outside the repository on a persistent disk/volume.
# Requires DATABASE_PATH and ffmpeg with libx264. Example: ~/.local/share/heartline/clips
CLIP_STORAGE_DIR=
CLIP_RETENTION_DAYS=7

# Voice, answer transcription, and explicit video preparation (also used by the Node reference).
SIMLI_API_KEY=
ELEVENLABS_API_KEY=

# Optional: choose an avatar and a voice from your provider dashboards.
SIMLI_FACE_ID=fa57b877-4b8a-4650-bc43-4d52ae795cdc
# live: the phone streams each line to a Simli live avatar (clips and voice are the fallback).
# clips: prepared clips only, without rebuilding the app.
AVATAR_MODE=live
ELEVENLABS_VOICE_ID=4ytNm4ZbEC9VLwa0Yy78
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STT_MODEL_ID=scribe_v2
# Node reference port; Uvicorn uses its --port argument.
PORT=3000
